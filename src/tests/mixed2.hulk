type Animal(name : String, age : Number) {
    name  = name;
    age = age;

    name() => self.name;
    change_name(new_name) => self.name := new_name;
    sound()  => "Mooo...";
    eat() => "Comiendo...";
}

type Perro inherits Animal {
    sound()  => "Guao guao...";
    eat()  => "No quiero, estoy enfermito";
}

type Gato inherits Animal {
    sound()  => "Miau Miau...";
}

type Point(x : Number,y : Number) {
    x : Number = x;
    y : Number = y;

    getX() : Number => self.x;
    getY() : Number => self.y;
    setX(x) : Number => self.x := x;
    setY(y) : Number => self.y := y;
}

type PolarPoint inherits Point {
    rho() : Number {
        sqrt(self.getX() ^ 2 + self.getY() ^ 2);
    }
}

function f(x : Animal) {
    print(x.sound());
}

type AnimalContainer(x: Animal) {
    x = x;
    sound() => print(self.x.sound());
    name(y: Animal) => print(self.x.name() @@ y.name());
    get_animal() => self.x;
}

type PerroContainer(x : Perro) inherits AnimalContainer(x) {
    name(y:Animal) => base(y);
    get_animal() => base();
}

let pepito = new Perro("pepito", 5), gatico : Animal = new Gato("gatito", 3) in {
    let cont = new AnimalContainer(pepito) in  {
        cont.name(gatico);
        let a = cont.get_animal() in {
            a.change_name("juanito");
            cont.name(gatico);
        };  
    };

    print(pepito.name());

    let pt = new PolarPoint(3,4) in print("rho: " @ pt.rho());

    let cont = new AnimalContainer(pepito) in  {
        cont.name(gatico);
        let a = cont.get_animal() in {
            a.change_name("juanito");
            cont.name(gatico);
        };  
    };

    print(pepito.name());
    print("");

    if (pepito.name() == "juanito") {
        print("El nombre de Pepito ahora es Juanito :|");
        if (gatico.name() == "gatico") {
            print("Gatico sigue siendo Gatico");
        } elif (gatico.name() == "juanito") {
            print("Gatico ahora es Juanito");
        } else {
            print("Gatico no es ni Gatico ni Juanito");
        };
    } else {
        print("Se sigue llamado Pepito");
    };

    let i = 0 in while (i < 10) {
        if (i % 2 == 0) {
            print("Iteracion" @@ i @@ gatico.name());
        } else {
            print("Iteracion" @@ i @@ pepito.name());
        };
        i := i + 1;
    };

    let pcont = new PerroContainer(pepito), a = pcont.get_animal() in {
        print(a.name());
        print(pcont.name(a));
    };
}
